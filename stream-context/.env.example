# ============================================
# STREAM CONTEXT - Variables de Entorno
# Copia a .env y completa tus credenciales
# ============================================

# --- Deepgram (Transcripcion de audio en tiempo real) ---
# https://console.deepgram.com/signup
DEEPGRAM_API_KEY=tu_clave_deepgram_aqui

# --- Google Gemini (Descripcion visual de frames) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_gemini_aqui

# --- Kick Channel (URL del en vivo a capturar) ---
# Ejemplo: https://kick.com/midel
KICK_CHANNEL_URL=https://kick.com/tu_canal

# --- FFmpeg (ruta completa si no esta en PATH) ---
# En Windows: C:\ffmpeg\bin\ffmpeg.exe
# En Linux/Mac: /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# --- Configuracion de captura ---
# Intervalo en segundos para capturar frames y generar resumen (cada 2 minutos)
FRAME_INTERVAL=120
# Ventana de segundos de audio a mantener en buffer para contexto (2 minutos)
AUDIO_WINDOW_SECONDS=120
# Calidad del stream a capturar (best, 1080p, 720p, 480p)
STREAM_QUALITY=best
