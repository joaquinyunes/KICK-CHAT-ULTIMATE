# Copiá este archivo como  .env  (en esta misma carpeta src/) y completá.
# common/config.py lo carga solo al arrancar cualquier módulo.
# Las líneas con # son comentarios. No pongas comillas salvo donde ya están.

# --- General --------------------------------------------------------------
KICK_CONTEXT_DATA_DIR=C:\Users\yunde\kick-context-data
KICK_CONTEXT_VENTANA_SEGUNDOS=180
KICK_CONTEXT_CLIP_SEGUNDOS=10

# --- Fuente de captura (Módulos 1 y 2) -------------------------------
# local  = ffmpeg captura la pantalla/ventana y el audio de la PC.
# remote = ffmpeg lee el HLS (.m3u8) del canal en vivo. No depende de esta PC
#          pero tiene ~20-40s de retraso. Para cambiar: editá y reiniciá.
KICK_CAPTURE_MODE=local
KICK_CANAL_SLUG=tu-canal
# Solo si la resolución automática por slug falla (Cloudflare): pegá acá la
# URL .m3u8 sacada del navegador (DevTools > Network > filtro "m3u8").
KICK_HLS_URL=

# --- Módulo 1: Captura de Video (modo local) ------------------------
KICK_VIDEO_SO=windows
KICK_VIDEO_FPS=10
KICK_VIDEO_RESOLUCION=1280x720
# QUÉ se captura (KICK_VIDEO_MODO). Default en Windows: "ventana".
#  ventana    -> una sola ventana, recortada exacta, y la sigue si la movés.
#                Cuál: KICK_VIDEO_WINDOW_TITLE (una parte del título; ver la
#                lista con:  python modulo01_captura_video/captura_video.py --listar).
#                Vacío = auto: la ventana más grande que NO esté en
#                KICK_VIDEO_IGNORAR (nunca StreamChat / OBS / panel).
#  activa     -> la ventana en primer plano; salta a la nueva al cambiar de foco.
#  monitor    -> un monitor entero (KICK_VIDEO_MONITOR = 1, 2, 3...).
#  escritorio -> todo el escritorio (todos los monitores).
#  dshow      -> dispositivo dshow (KICK_VIDEO_DSHOW, ej. "OBS Virtual Camera").
# Si se deja vacío se infiere: DSHOW > WINDOW_TITLE > MONITOR > ventana.
# NOTA: esto es solo el default. Con el Panel corriendo, la sección
# "Qué pantalla analizar" te deja cambiar la fuente al vuelo (desplegable con
# monitores + ventanas + Aplicar).
KICK_VIDEO_MODO=ventana
KICK_VIDEO_WINDOW_TITLE=
# Títulos que NUNCA se capturan (separados por coma).
KICK_VIDEO_IGNORAR=OBS,Task Manager,Administrador de tareas,Panel de Control,kick-context,StreamChat
KICK_VIDEO_MONITOR=
KICK_VIDEO_DSHOW=

# --- Módulo 2: Captura de Audio (modo local) ----------------------
KICK_AUDIO_SO=windows
# Dispositivo principal (audio del sistema / lo que escuchan los viewers).
# Ver nombres:  ffmpeg -list_devices true -f dshow -i dummy
KICK_AUDIO_DEVICE=Stereo Mix (Realtek(R) Audio)
# Opcional: segundo dispositivo (micrófono). Si lo ponés, se mezcla.
KICK_AUDIO_DEVICE_2=

# --- Módulo 4: Transcripción (faster-whisper) --------------------------
# tiny = rápido, para CPU sin GPU. base/small = mejor calidad si tu CPU aguanta.
KICK_WHISPER_MODEL=tiny
KICK_WHISPER_DEVICE=cpu
KICK_WHISPER_IDIOMA=es
KICK_WHISPER_VAD=1

# --- Módulo 5: Análisis Visual (OCR) ----------------------------------
# APAGADO por defecto en el orquestador: con Gemini, el Módulo 8 mira el
# frame directo (mejor). Estas variables solo aplican si lo reactivás.
KICK_VISUAL_OCR_IDIOMA=spa
KICK_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Módulo 6: Metadata de Kick (opcional al principio) --------------
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8080/callback
KICK_ACCESS_TOKEN=
KICK_REFRESH_TOKEN=

# --- Módulo 8: Resumen LLM -----------------------------------------
# gemini = nube, free tier (aistudio.google.com).  ollama = local.
KICK_LLM_PROVIDER=gemini
KICK_RESUMEN_INTERVALO_SEG=120
KICK_RESUMEN_AUDIO=1
KICK_GEMINI_API_KEY=
KICK_GEMINI_MODEL=gemini-flash-lite-latest
# Si el primero da 503/429, prueba el siguiente (coma):
KICK_GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
# Solo para provider=ollama:
KICK_CONTEXT_OLLAMA_URL=http://localhost:11434/api/generate
KICK_CONTEXT_OLLAMA_MODEL=llama3.1:8b

# --- Módulo 12: Comentarista IA (chat simulado en el chat de Kick) --
# Usa el "prompt maestro" src/modulo12_comentarista/prompt_chat.txt: le
# inyecta el contexto del stream y pide un LOTE de mensajes en 1 sola llamada.
KICK_COMENTARIO_LOTE=30
# CADENCIA (cada cuánto manda mensajes). Esto es el default: desde el Panel
# ("Cada cuánto mandar mensajes al chat") se cambia en caliente y queda
# guardado en <data>/control/comentarista.json.
# bloque = genera y vuelca el lote entero cada KICK_COMENTARIO_BLOQUE_SEG.
# goteo  = suelta los mensajes de a uno, cada X seg, X al azar entre
#          KICK_COMENTARIO_MIN_SEG y KICK_COMENTARIO_MAX_SEG.
KICK_COMENTARIO_MODO=goteo
KICK_COMENTARIO_BLOQUE_SEG=300
KICK_COMENTARIO_MIN_SEG=25
KICK_COMENTARIO_MAX_SEG=70
# (compat) si no ponés MIN/MAX, se usa este como mínimo.
KICK_COMENTARIO_INTERVALO_SEG=30
KICK_COMENTARIO_REGEN_UMBRAL=4
# 1 = genera comentarios aunque el canal esté offline (solo para probar).
KICK_COMENTARIO_IGNORAR_OFFLINE=0
# 0 = modo ensayo (genera y guarda, NO postea).
# 1 = publica en el chat de tu canal vía la API oficial de Kick.
#     Requiere correr login_kick.py una vez con el scope chat:write
#     (KICK_CLIENT_ID / KICK_CLIENT_SECRET arriba, en el bloque Módulo 6).
KICK_COMENTARIO_POSTEAR=0
KICK_COMENTARIO_MAX_CHARS=240
# Ruta alternativa al prompt maestro (default:
# src/modulo12_comentarista/prompt_chat.txt, editable desde el Panel).
KICK_PROMPT_CHAT_FILE=
# TXT que se va actualizando con cada mensaje soltado, para que lo consuma
# otro proyecto (ej. "kick chat"). Vacío = <DATA_DIR>/comentarios/chat_feed.txt
KICK_COMENTARIO_TXT_OUT=
# plain = un mensaje por línea | ts = epoch<TAB>mensaje | jsonl
KICK_COMENTARIO_TXT_FORMATO=plain
KICK_COMENTARIO_TXT_MAX_LINEAS=500
# Además, cada lote se deja en <DATA_DIR>/comentarios/lotes/ como
# lote_<ts>.txt + lote_<ts>.json para que otro proyecto lo levante
# (ver modulo12_comentarista/consumidor_ejemplo.py).
# Opcional: mandar cada lote por HTTP POST (JSON {timestamp, mensajes}):
KICK_COMENTARIO_WEBHOOK=
# Opcional: ejecutar tu otro proyecto tras cada lote (recibe la ruta del
# lote_<ts>.json como último argumento) — así "se carga solo":
#   KICK_COMENTARIO_HOOK_CMD=python C:\mi-otro-proyecto\cargar.py
KICK_COMENTARIO_HOOK_CMD=

# --- Módulo 11: Panel de Control -----------------------------------
# Generá PANEL_PASSWORD_HASH y PANEL_SECRET_KEY con:
#   python modulo11_panel_control/generar_password.py
PANEL_USUARIO=admin
PANEL_PASSWORD_HASH=
PANEL_SECRET_KEY=
PANEL_PUERTO=5000
PANEL_HOST=127.0.0.1
