# ─── StreamChat Bridge — Variables de entorno ───────────────────
# Copiá este archivo a .env y completá los valores.

NODE_ENV=development
PORT=3000
# LOG_LEVEL=debug            # fatal|error|warn|info|debug|trace (opcional)

# ─── Cripto / Auth ─────────────────────────────────────────────
# 32 bytes en hex. Generar: openssl rand -hex 32
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secreto para firmar JWT (>=32 chars). Generar: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_32+_chars
JWT_EXPIRES_IN=24h

# ─── CORS (solo producción) ────────────────────────────────────
# APP_URL=https://tu-dominio.com

# ─── Endpoint de métricas (/metrics) ───────────────────────────
# Sin esto, /metrics queda bloqueado. Generar: openssl rand -hex 24
ADMIN_SECRET=

# ─── Kick OAuth — API oficial (dev.kick.com) ───────────────────
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/auth/kick/callback

# ─── Simulador de chat (opcional; sin esto usa generador local) ─
OPENROUTER_API_KEY=

# ─── Workers Python (VOD viewer / senders) ─────────────────────
# PYTHON_PATH=python

# ═══ Pipeline de contexto (kick-context/) ══════════════════════
# El pipeline Python (ex proyecto-kick-context) captura el stream, resume con
# Gemini y el Módulo 12 genera un lote de ~30 líneas de chat cada 5 min.
# El server Node lo supervisa (lo arranca/reinicia) si KC_PIPELINE_ENABLED=1.
# Necesita: Python 3.11 + ffmpeg en PATH + KICK_GEMINI_API_KEY.
KC_PIPELINE_ENABLED=0
# Probar TODO el flujo sin estar en stream ni capturar pantalla:
# M8 genera resúmenes sintéticos y M12 arma el lote real con Gemini.
# (necesita KICK_GEMINI_API_KEY igual, para el M12).
KC_SIMULATION=0
# KC_DIR=                                # default: ../kick-context
# KICK_CONTEXT_DATA_DIR=                 # default: ../kick-context-data

# Ingesta: KCU lee el lote_<ts>.json más nuevo y carga sus ~30 líneas solo.
KC_INGEST_ENABLED=1
KC_INGEST_POLL_SEG=300
# KC_LOTES_DIR=                          # default: <KICK_CONTEXT_DATA_DIR>/comentarios/lotes

# Envío: KCU manda esas líneas al chat con el pool de bearers, espaciadas.
# (KC nunca postea — el supervisor le fuerza KICK_COMENTARIO_POSTEAR=0.)
KC_SEND_ENABLED=1
KC_SEND_INTERVAL_SEG=10                  # ~30 líneas / 10s ≈ repartidas en 5 min
# KC_SEND_CHANNEL=                       # default: KICK_CANAL_SLUG

# ─── Claves del pipeline Python (se pasan tal cual a kick-context/) ──
KICK_GEMINI_API_KEY=
KICK_GEMINI_MODEL=gemini-flash-lite-latest
KICK_GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
KICK_LLM_PROVIDER=gemini
KICK_CAPTURE_MODE=local
KICK_CANAL_SLUG=
KICK_COMENTARIO_LOTE=30
KICK_COMENTARIO_MODO=bloque
KICK_COMENTARIO_BLOQUE_SEG=300
