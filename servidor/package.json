{
  "name": "streamchat-bridge-server",
  "version": "1.0.0",
  "description": "StreamChat Bridge - Servidor Central FASE 1",
  "main": "dist/server-engine.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server-engine.ts",
    "build": "tsc && node scripts/copy-worker.js",
    "start": "node dist/server-engine.js",
    "typecheck": "tsc --noEmit",
    "kc:install": "python -m pip install -r ../kick-context/src/requirements.txt",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "create-user": "ts-node scripts/create-user.ts",
    "assign-bot": "ts-node scripts/assign-bot.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sql.js": "^1.14.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
