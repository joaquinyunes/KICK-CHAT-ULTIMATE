# ── Motor de análisis ──────────────────────────────────────────────────────────
# auto (por defecto) usa el primero que esté listo: Ollama → Gemini → Claude → OCR integrado.
# El OCR integrado no necesita nada instalado ni ninguna clave: lee el texto de la pantalla y lo interpreta con reglas.
# PANTALLA_BACKEND=auto            # auto | ollama | gemini | claude | ocr

# OCR integrado (sin Ollama y sin claves). Lee TEXTO, no entiende imágenes.
# PANTALLA_OCR_LANGS=eng           # eng, spa o eng+spa (más acentos, ~40 MB más de RAM)
# PANTALLA_OCR_KEEP_ALIVE_S=60     # segundos sin usarse tras los cuales se libera la memoria del OCR (~160 MB)
# PANTALLA_KNOWLEDGE_FILE=         # JSON propio con tus juegos, equipos, ligas... (ver README)

# Opción 1 · GRATIS y LOCAL (Ollama). Instálalo desde https://ollama.com y ejecuta: ollama pull qwen3-vl:2b
# OLLAMA_HOST=127.0.0.1:11434
# PANTALLA_OLLAMA_MODEL=qwen3-vl:2b
# PANTALLA_OLLAMA_KEEP_ALIVE=60s   # tiempo sin usarse tras el cual Ollama saca el modelo de la RAM
# PANTALLA_OLLAMA_THREADS=         # limita los hilos de CPU para dejar núcleos libres al stream
# PANTALLA_OLLAMA_THINK=           # 0 desactiva el razonamiento en modelos que lo tengan (más rápido)
# PANTALLA_OLLAMA_TIMEOUT_S=180

# Opción 2 · GRATIS en la nube, con límites (clave de https://aistudio.google.com). El contenido enviado
# puede usarse para mejorar productos de Google: no lo uses con pantallas privadas.
# GEMINI_API_KEY=
# PANTALLA_GEMINI_MODEL=gemini-flash-lite-latest

# Opción 3 · DE PAGO (Claude, la mayor calidad de lectura)
# ANTHROPIC_API_KEY=
# PANTALLA_CLAUDE_MODEL=claude-opus-5-5   # p. ej. claude-sonnet-5-5 para ahorrar coste
# PANTALLA_CLAUDE_EFFORT=low              # low | medium | high | xhigh | max
# PANTALLA_CLAUDE_FALLBACKS=1             # 0 desactiva el reintento automático en otro modelo

# Tamaño máximo (lado largo) de la imagen enviada. Por defecto: 768 Ollama, 1024 Gemini, 1568 Claude, 1600 OCR.
# Menos píxeles = menos tokens = más rápido y barato.
# PANTALLA_MAX_SIDE=

# ── Qué se exporta y cuándo es «seguro» ───────────────────────────────────────
# Por defecto SOLO sale lo VERIFICADO: certeza suficiente Y la misma actividad en lecturas seguidas.
# Verificado no es una garantía de que sea cierto: es «el OCR lo leyó con evidencia suficiente y de forma repetida».
# PANTALLA_EXPORT=verified         # verified (solo lo seguro) | all (también lo no verificado, marcado)
# PANTALLA_MIN_CERTAINTY=0.5       # 0..1; súbelo para exigir más seguridad (se exportará menos)
# PANTALLA_STABLE_FRAMES=2         # lecturas seguidas iguales antes de verificar (1..10)
# PANTALLA_SWITCH_FRAMES=2         # lecturas seguidas de otra actividad antes de darla por cambiada
# PANTALLA_ACTIVITY_GAP_S=300      # sin lecturas durante este tiempo, el contexto caduca y deja de exportarse
# Si defines un token, leer la API de exportación (/api/context, /api/session, /api/events) exige
# «Authorization: Bearer <token>» (o ?token=). Abre entonces el visor como http://127.0.0.1:3000/?token=TU_TOKEN.
# No protege POST /api/analyze: cualquier proceso de tu equipo puede mandar capturas al visor.
# PANTALLA_API_TOKEN=

# ── Conectar con OTRA IA ───────────────────────────────────────────────────────
# a) Una IA de TEXTO que refina el resultado del OCR (nunca recibe la imagen). Cualquier servicio con la API de
#    chat de OpenAI (/chat/completions): Gemini (endpoint compatible), Groq, OpenRouter, Mistral, LM Studio, Ollama...
#    Úsala con PANTALLA_BACKEND=ocr. Si falla, se conserva el análisis local.
# PANTALLA_LLM_URL=https://api.groq.com/openai/v1
# PANTALLA_LLM_MODEL=
# PANTALLA_LLM_KEY=                # opcional en servidores locales
# PANTALLA_LLM_JSON_MODE=1         # 0 si el servidor no admite response_format
# PANTALLA_LLM_TIMEOUT_S=60
# b) Webhook: cada contexto nuevo se envía a esta URL (n8n, Make, un bot...). Con secreto, va firmado (HMAC-SHA256).
# PANTALLA_WEBHOOK_URL=
# PANTALLA_WEBHOOK_SECRET=
# c) Servidor MCP (pantalla-contexto mcp) y comandos context/activity: si el visor no escucha en el puerto 3000, indícalo aquí.
# PANTALLA_URL=http://127.0.0.1:3000

# ── Dos programas: el visor y el analizador ───────────────────────────────────
# El visor (npm start) ve la pantalla. El analizador (npm run analyzer) puede correr en OTRO equipo.
# En el equipo del stream, apunta el visor al analizador:
# PANTALLA_ANALYZER_URL=http://192.168.1.50:4000
# PANTALLA_ANALYZER_TOKEN=         # secreto compartido (obligatorio si el analizador escucha fuera de localhost)
# En el equipo del analizador:
# PANTALLA_ANALYZER_HOST=127.0.0.1 # 0.0.0.0 para recibir de otros equipos (exige PANTALLA_ANALYZER_TOKEN)
# PANTALLA_ANALYZER_PORT=4000

# ── Servidor del visor ─────────────────────────────────────────────────────────
# PORT=3000                        # también --port
# HOST=127.0.0.1                   # no lo cambies salvo que sepas lo que haces
